# Copy this file to `.env` and adjust the values:
#   macOS / Linux:  cp .env.example .env
#   Windows (PowerShell):  Copy-Item .env.example .env
#
# `.env.example` is committed to git as a TEMPLATE. `.env` holds your real values and is ignored
# by git (see .gitignore), so passwords never end up in the repository.
#
# Format:  postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# This default matches the Docker command in the README (user postgres, password postgres,
# database gatherly). If you installed PostgreSQL locally, use YOUR user/password. On a Mac with
# Homebrew there is usually no password: postgres://YOUR_MAC_USERNAME@localhost:5432/gatherly
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gatherly

# ── Authentication (Better Auth) ──────────────────────────────────────────────────────
# A long random string used to sign and encrypt session data. Keep it SECRET, and use a different one
# in production. Generate it in a terminal with either command:
#   npx auth@latest secret
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# "Continue with GitHub" is optional: it appears only when BOTH values below are set.
# Where to get them: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App,
# with the callback URL  http://localhost:3000/api/auth/callback/github
# (step by step in the class 07 README, "Getting the GitHub credentials").
# The secret is shown only once. NEVER commit the real values: they belong in `.env` only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
